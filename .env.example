# Claudio v2 environment template — copy to .env.local and fill in
# Never commit .env.local

# ─── Required: Claude (Anthropic) — primary AI ──────────────────────────────
# Used as the SERVER-SIDE default in Phase 1 (BYOK lands in Phase 2).
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Claude model id. Defaults to claude-sonnet-4-6 if unset.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Recommended: OpenRouter — multi-provider AI backbone ───────────────────
# Phase 6.5 router uses this for non-Claude models (DeepSeek, Gemini, GPT-5,
# Codestral, etc.). One key, 200+ models. Get one at https://openrouter.ai/keys
# If unset, the router falls back to anthropic-direct only.
OPENROUTER_API_KEY=

# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Feature flags (optional) ───────────────────────────────────────────────
ENABLE_STREAMING=true
DEBUG_CLAUDE=false
DEBUG_INTENT_DETECTION=false
DEBUG_PROMPTS=false

# ─── Phase 2 — uncomment when adding auth + DB ──────────────────────────────
# Clerk (auth)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon (Postgres)
# DATABASE_URL=postgres://...

# BYOK encryption key (32-byte base64 secret for libsodium secretbox)
# ENCRYPTION_KEY=

# ─── Phase 4 — observability ───────────────────────────────────────────────
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
